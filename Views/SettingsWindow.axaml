<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PNGTA.ViewModels"
        x:Class="PNGTA.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Width="600" Height="400"
        Title="Settings"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <TabControl TabStripPlacement="Left" Margin="10">
        <TabItem Header="Preferences">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="Preferences" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="General options will go here..." Foreground="#AAAAAA"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Audio">
            <StackPanel Margin="20" Spacing="15">
                <TextBlock Text="Microphone Setup" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                
                <TextBlock Text="Input Device:" Foreground="#CCCCCC"/>
                <ComboBox ItemsSource="{Binding AudioDevices}" 
                          SelectedItem="{Binding SelectedAudioDevice}" 
                          HorizontalAlignment="Stretch" CornerRadius="6"/>
                
                <TextBlock Text="{Binding Threshold, StringFormat='Microphone Threshold: {0:F2}'}" Foreground="#CCCCCC" Margin="0,10,0,0"/>
                <Slider Minimum="0.01" Maximum="1.0" Value="{Binding Threshold}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>